# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Festoon"
# International format, digits only (used for wa.me and tel: links)
NEXT_PUBLIC_CONCIERGE_WHATSAPP=919800000000
NEXT_PUBLIC_CONCIERGE_PHONE=+919800000000

# ── Database (Supabase / any Postgres) ───────────────
# Through a transaction pooler (Supabase :6543, PgBouncer) append ?pgbouncer=true
DATABASE_URL=postgresql://app_user:password@localhost:5432/festoon
# Direct (non-pooled) URL for migrations
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/festoon
# If DATABASE_URL's user is a superuser / BYPASSRLS, name the restricted role to
# switch into per transaction so row-level security still applies.
APP_DB_ROLE=app_user

# ── Security ─────────────────────────────────────────
# 32+ random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET=
# AES-256-GCM key for customer PII at rest (exactly 32 bytes, base64)
DATA_ENCRYPTION_KEY=
# HMAC pepper for OTP codes and PII lookup hashes
HASH_PEPPER=

# ── Rate limiting (Upstash Redis) ────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── OTP delivery ─────────────────────────────────────
# console | whatsapp | twilio
OTP_PROVIDER=console
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=otp_login
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Email OTPs (Resend)
RESEND_API_KEY=
EMAIL_FROM="Festoon <hello@example.com>"

# ── Payments ─────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
